#!/bin/bash
# ============================================================================
# STRATA-GLM-QUETZA - GLM-5.3-Flash on the Strata-GLM engine (~/AI/Strata-GLM), QuetzaCodetl in front
#
# Engine:  build-glm-gpu/glm_generate --serve (Strata's engine line protocol) via tools/glm/serve/glm-engine.sh
#          (shared GPU lock with strata-ds4-gpu, 84 GiB RAM cap, refuses while ComfyUI runs)
# Server:  Strata's serve.server through tools/glm/serve/serve_glm.py (GLM tokenizer/template/tool calls)
#          OpenAI (/v1) + Anthropic (/v1/messages) + /health
# Model:   GLM-5.3-Flash GSQ-RCO 3.0-bit, soft REAP prune 25% (penalty 0.05) + skip-file/skip-miss (FINDINGS s12-s15)
# Default: UNCENSORED = abliteration LoRA (gcsa-abliterix v2, dense half: attn_output + shared-expert down) port 8140
#          --stock: no LoRA, port 8141
# Context: 524288 (512K; MLA latent cache ~6 GB VRAM, fewer expert slots -> decode ~7-9 tok/s)
# Multi-turn: the engine snapshots the state at the end of every prompt; a follow-up that extends it reads only the
#          new tokens.
# Usage:   strata-glm-quetza [--stock] [--port=N] [-- <quetza args>]
# ============================================================================
set -eE
WRAPPER_NAME="strata-glm-quetza"
GLM_DIR="/home/mal/AI/Strata-GLM"
PY="/home/mal/AI/Strata/.venv/bin/python"
SHIM="$GLM_DIR/tools/glm/serve/serve_glm.py"
CONFIG_UNC="$GLM_DIR/tools/glm/serve/strata-glm-unc.json"
CONFIG_STOCK="$GLM_DIR/tools/glm/serve/strata-glm.json"
CONTEXT_SIZE=524288
LOCAL_HOST="127.0.0.1"
UNCENSORED=1
PORT_SET=0
QUETZA_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --port=*)            LOCAL_PORT="${arg#--port=}"; PORT_SET=1 ;;
        --stock|--censored)  UNCENSORED=0 ;;
        --uncensored|--unc)  UNCENSORED=1 ;;
        *)                   QUETZA_ARGS+=("$arg") ;;
    esac
done
if [ "$UNCENSORED" = 1 ]; then
    CONFIG="$CONFIG_UNC"; [ "$PORT_SET" = 0 ] && LOCAL_PORT=8140; MODEL_NAME="glm-5.3-flash-strata-abliterated"
else
    CONFIG="$CONFIG_STOCK"; [ "$PORT_SET" = 0 ] && LOCAL_PORT=8141; MODEL_NAME="glm-5.3-flash-strata"
fi
LOCAL_URL="http://$LOCAL_HOST:$LOCAL_PORT"
SERVER_LOG="/tmp/strata-glm-quetza-$LOCAL_PORT.log"
SERVER_PID_FILE="/tmp/strata-glm-quetza-$LOCAL_PORT.pid"

log_info() { echo -e "\033[1;34m[INFO]\033[0m $*"; }
log_ok()   { echo -e "\033[1;32m[+]\033[0m $*"; }
log_err()  { echo -e "\033[1;31m[ERROR]\033[0m $*"; }

CLEANED=false
cleanup() {
    [ "$CLEANED" = true ] && return
    CLEANED=true
    if [ -f "$SERVER_PID_FILE" ]; then
        local pid; pid=$(cat "$SERVER_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
            sleep 2
            kill -9 -- -"$pid" 2>/dev/null || true
            log_ok "stopped Strata-GLM (pid $pid); GPU lock released"
        fi
        rm -f "$SERVER_PID_FILE"
    fi
}
trap cleanup EXIT INT TERM

if curl -s --max-time 2 "$LOCAL_URL/health" >/dev/null 2>&1; then
    log_ok "Strata-GLM already running at $LOCAL_URL - attaching"
else
    [ -x "$PY" ] || { log_err "missing $PY (Strata venv)"; exit 1; }
    [ -x "$GLM_DIR/build-glm-gpu/glm_generate" ] || { log_err "missing build-glm-gpu/glm_generate"; exit 1; }
    if ss -ltn 2>/dev/null | grep -q ':8188 '; then
        log_err "ComfyUI is running on :8188 - stop it first (the engine needs ~80 GB RAM)"; exit 1
    fi
    if ! flock -n "$HOME/.quetza-data/conductor/ds4-gpu.lock" true; then
        log_info "the GPU lock is held (a DS4/GLM benchmark?) - the engine will wait for it"
    fi
    log_info "Starting Strata-GLM ($([ "$UNCENSORED" = 1 ] && echo "uncensored: abliteration LoRA" || echo stock)) on $LOCAL_URL ..."
    log_info "  config: $CONFIG"
    setsid "$PY" "$SHIM" --engine strata --config "$CONFIG" --host "$LOCAL_HOST" --port "$LOCAL_PORT" \
        > "$SERVER_LOG" 2>&1 < /dev/null &
    echo $! > "$SERVER_PID_FILE"
    server_pid=$(cat "$SERVER_PID_FILE")
    log_info "  pid $server_pid - log $SERVER_LOG (engine log: /tmp/$(basename "$CONFIG" .json).log; load ~1-2 min)"
    for i in $(seq 1 240); do
        if curl -s --max-time 2 "$LOCAL_URL/health" >/dev/null 2>&1; then
            log_ok "ready: $LOCAL_URL/v1 (OpenAI) - $LOCAL_URL/v1/messages (Anthropic)"
            break
        fi
        if ! kill -0 "$server_pid" 2>/dev/null; then
            log_err "server died during load; tail of $SERVER_LOG:"; tail -15 "$SERVER_LOG" 2>/dev/null
            tail -15 "/tmp/$(basename "$CONFIG" .json).log" 2>/dev/null
            exit 1
        fi
        sleep 2
    done
fi

QUETZA_DIR="/home/mal/AI/QuetzaCodetl"
cd "$QUETZA_DIR" || exit 1
log_ok "Starting QuetzaCodetl ..."
log_info "  endpoint: $LOCAL_URL - model: $MODEL_NAME - context: $((CONTEXT_SIZE / 1024))K"
env \
    -u MODEL_NAME -u LOCAL_MODEL_NAME \
    QUETZA_LOCAL_MODE=1 \
    QUETZA_CODE_REPL=1 \
    QUETZA_NATIVE_TOOLS=1 \
    QUETZA_EXPERIMENTAL_DEFER_TOOLS=1 \
    QUETZA_MAX_OUTPUT_TOKENS="${QUETZA_MAX_OUTPUT_TOKENS:-32768}" \
    BASH_MAX_OUTPUT_LENGTH="${BASH_MAX_OUTPUT_LENGTH:-12000}" \
    TASK_MAX_OUTPUT_LENGTH="${TASK_MAX_OUTPUT_LENGTH:-12000}" \
    ENABLE_TOOL_SEARCH=false \
    QUETZA_ENDPOINT="$LOCAL_URL" \
    QUETZA_CONTEXT_SIZE="$CONTEXT_SIZE" \
    QUETZA_MODEL_NAME="$MODEL_NAME" \
    ANTHROPIC_BASE_URL="$LOCAL_URL" \
    ANTHROPIC_API_KEY="local-dummy-key" \
    COLORTERM=truecolor \
    DISABLE_TELEMETRY=1 \
    DISABLE_AUTO_UPDATE=1 \
    SKIP_HOOKS=1 \
    bun ./dist/cli.mjs "${QUETZA_ARGS[@]}"
EXIT_CODE=$?
log_info "QuetzaCodetl exited with code $EXIT_CODE"
exit $EXIT_CODE
